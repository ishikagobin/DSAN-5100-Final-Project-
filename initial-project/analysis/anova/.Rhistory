# 1. Vertical Bars
# We swapped x and y in the aes() above.
geom_col(position = position_dodge(width = 0.9), width = 0.8) +
# 2. Adjust Text Labels for Vertical Bars
# vjust = -0.5 puts the number on top of the standing bar
geom_text(aes(label = n),
position = position_dodge(width = 0.9),
vjust = -0.5,
size = 3) +
# Facet remains the same
facet_wrap(~ time_period) +
labs(
title = "Significant Differences: Before vs. After Patternizr",
subtitle = "Comparison of outcome frequency by contrast pair",
x = NULL, # Remove X label since the text is self-explanatory
y = "Frequency of Occurrence Across Precincts",
fill = "Representation"
) +
# Wrap the text a bit tighter since it's on the bottom now
scale_x_discrete(labels = function(x) str_wrap(x, width = 20)) +
scale_fill_manual(values = c("greater than" = "#0072B2", "less than" = "#D55E00")) +
theme_minimal() +
theme(
# 3. TILT THE LABELS
# angle = 45 rotates the text. hjust = 1 aligns it so it doesn't overlap the bar.
#axis.text.x = element_text(angle = 45, hjust = 1, size = 9),
# 4. CENTER THE TITLES
# hjust = 0.5 moves the title to the middle of the plot
plot.title = element_text(hjust = 0.5, face = "bold"),
plot.subtitle = element_text(hjust = 0.5),
# Add extra margin at the bottom so the tilted text doesn't get cut off
plot.margin = margin(t = 10, r = 10, b = 20, l = 10),
panel.border = element_rect(color = "gray", fill = NA, size = 0.5),
strip.text = element_text(face = "bold", size = 11)
)
sig_gaps_count_plot
# Ensure the time_period order is correct
sig_gaps_count$time_period <- factor(sig_gaps_count$time_period,
levels = c("before Patternizr", "after Patternizr"))
sig_gaps_count_plot <- ggplot(sig_gaps_count, aes(x = contrast, y = n, fill = representation)) +
# 1. Vertical Bars
# We swapped x and y in the aes() above.
geom_col(position = position_dodge(width = 0.9), width = 0.8) +
# 2. Adjust Text Labels for Vertical Bars
# vjust = -0.5 puts the number on top of the standing bar
geom_text(aes(label = n),
position = position_dodge(width = 0.9),
vjust = -0.5,
size = 3) +
# Facet remains the same
facet_wrap(~ time_period) +
labs(
title = "Significant Differences: Before vs. After Patternizr",
subtitle = "Comparison of outcome frequency by contrast pair",
x = NULL, # Remove X label since the text is self-explanatory
y = "Frequency of Occurrence Across Precincts",
fill = "Representation"
) +
# Wrap the text a bit tighter since it's on the bottom now
scale_x_discrete(labels = function(x) str_wrap(x, width = 20)) +
scale_fill_manual(values = c("over" = "#0072B2", "under" = "#D55E00")) +
theme_minimal() +
theme(
# 3. TILT THE LABELS
# angle = 45 rotates the text. hjust = 1 aligns it so it doesn't overlap the bar.
#axis.text.x = element_text(angle = 45, hjust = 1, size = 9),
# 4. CENTER THE TITLES
# hjust = 0.5 moves the title to the middle of the plot
plot.title = element_text(hjust = 0.5, face = "bold"),
plot.subtitle = element_text(hjust = 0.5),
# Add extra margin at the bottom so the tilted text doesn't get cut off
plot.margin = margin(t = 10, r = 10, b = 20, l = 10),
panel.border = element_rect(color = "gray", fill = NA, size = 0.5),
strip.text = element_text(face = "bold", size = 11)
)
sig_gaps_count_plot
ggsave("anova_contrast_pairs.png", plot = sig_gaps_count_plot, width = 10, height = 6, units = "in", dpi = 300)
