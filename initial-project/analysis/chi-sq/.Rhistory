"Under" = "#527699",
"NS"    = "#D3D1C7"
)
# ── Plot ──────────────────────────────────────────────────────────────────────
p <- ggplot(df, aes(x = col, y = row, fill = outcome)) +
geom_point(shape = 21, size = 4.5, color = "white", stroke = 0.4) +
facet_grid(
pair ~ phase,
switch = "y"
) +
scale_fill_manual(
values = dot_colors,
labels = c("Overrepresented", "Underrepresented", "Not significant"),
name   = NULL
) +
scale_y_reverse() +
coord_equal() +
labs(
title    = "Significant Differences: before vs. after Patternizr",
subtitle = "Each dot represents 1 of 20 precincts tested per group pair",
caption  = "Colored dots = precincts where group 1 is significantly over- or underrepresented relative to group 2"
) +
theme_minimal(base_size = 12, base_family = "sans") +
theme(
# Strips
strip.text.y.left   = element_text(angle = 0, hjust = 1, size = 10, face = "bold"),
strip.text.x         = element_text(size = 11, face = "bold", margin = margin(b = 8)),
strip.placement       = "outside",
# Axes — hide them, the dots speak for themselves
axis.text  = element_blank(),
axis.title = element_blank(),
axis.ticks = element_blank(),
# Grid
panel.grid = element_blank(),
# Legend
legend.position  = "top",
legend.justification = "center",
legend.key.size  = unit(0.4, "cm"),
legend.text      = element_text(size = 10),
# Title
plot.title    = element_text(face = "bold", size = 14, hjust = 0.5),
plot.subtitle = element_text(size = 10, hjust = 0.5, color = "gray40",
margin = margin(b = 12)),
plot.caption  = element_text(size = 8, color = "gray50", hjust = 0.5,
margin = margin(t = 10)),
# Spacing
panel.spacing.x = unit(1.5, "cm"),
panel.spacing.y = unit(0.8, "cm"),
plot.margin     = margin(15, 15, 10, 15)
)
# ── Save ──────────────────────────────────────────────────────────────────────
ggsave("patternizr_dot_matrix.png", p, width = 8, height = 5, dpi = 300, bg = "white")
#ggsave("patternizr_dot_matrix.pdf", p, width = 8, height = 5, bg = "white")
print(p)
library(tidyverse)
# ── Data ──────────────────────────────────────────────────────────────────────
# Each row = one precinct (20 per group pair × 2 phases = 120 rows)
pairs <- c(
"Am. Indian/Alaska Native\nvs White",
"Asian/Pacific Islander\nvs Black",
"Black\nvs White"
)
make_dots <- function(phase, pair_label, n_over, n_under) {
n_ns <- 20 - n_over - n_under
tibble(
phase = phase,
pair  = factor(pair_label, levels = pairs),
precinct = 1:20,
outcome = factor(
c(rep("Over", n_over), rep("Under", n_under), rep("NS", n_ns)),
levels = c("Over", "Under", "NS")
)
)
}
df <- bind_rows(
make_dots("Before Patternizr", pairs[1], 9, 0),
make_dots("Before Patternizr", pairs[2], 10, 0),
make_dots("Before Patternizr", pairs[3], 0, 5),
make_dots("After Patternizr",  pairs[1], 5, 0),
make_dots("After Patternizr",  pairs[2], 0, 1),
make_dots("After Patternizr",  pairs[3], 1, 1)
) %>%
mutate(
phase = factor(phase, levels = c("Before Patternizr", "After Patternizr")),
# Grid positions: 10 columns × 2 rows of dots
col = (precinct - 1) %% 10 + 1,
row = (precinct - 1) %/% 10 + 1
)
# ── Colors ────────────────────────────────────────────────────────────────────
dot_colors <- c(
"Over"  = "#C6983B",
"Under" = "#527699",
"NS"    = "#D3D1C7"
)
# ── Plot ──────────────────────────────────────────────────────────────────────
p <- ggplot(df, aes(x = col, y = row, fill = outcome)) +
geom_point(shape = 21, size = 4.5, color = "white", stroke = 0.4) +
facet_grid(
pair ~ phase,
switch = "y"
) +
scale_fill_manual(
values = dot_colors,
labels = c("Overrepresented", "Underrepresented", "Not significant"),
name   = NULL
) +
scale_y_reverse() +
coord_equal() +
labs(
title    = "Significant Differences in Pairwise Representation\nbefore vs. after Patternizr",
subtitle = "Each dot represents 1 of 20 precincts tested per group pair",
caption  = "Colored dots = precincts where group 1 is significantly over- or underrepresented relative to group 2"
) +
theme_minimal(base_size = 12, base_family = "sans") +
theme(
# Strips
strip.text.y.left   = element_text(angle = 0, hjust = 1, size = 10, face = "bold"),
strip.text.x         = element_text(size = 11, face = "bold", margin = margin(b = 8)),
strip.placement       = "outside",
# Axes — hide them, the dots speak for themselves
axis.text  = element_blank(),
axis.title = element_blank(),
axis.ticks = element_blank(),
# Grid
panel.grid = element_blank(),
# Legend
legend.position  = "top",
legend.justification = "center",
legend.key.size  = unit(0.4, "cm"),
legend.text      = element_text(size = 10),
# Title
plot.title    = element_text(face = "bold", size = 14, hjust = 0.5),
plot.subtitle = element_text(size = 10, hjust = 0.5, color = "gray40",
margin = margin(b = 12)),
plot.caption  = element_text(size = 8, color = "gray50", hjust = 0.5,
margin = margin(t = 10)),
# Spacing
panel.spacing.x = unit(1.5, "cm"),
panel.spacing.y = unit(0.8, "cm"),
plot.margin     = margin(15, 15, 10, 15)
)
# ── Save ──────────────────────────────────────────────────────────────────────
ggsave("patternizr_dot_matrix.png", p, width = 8, height = 5, dpi = 300, bg = "white")
#ggsave("patternizr_dot_matrix.pdf", p, width = 8, height = 5, bg = "white")
print(p)
#sort residual df by highest absolute value of standard residual
sorted_residuals <- all_residuals |>
arrange(desc(abs(std_residual)))
#print(sorted_residuals)
#filter to only after Patternizr
after_sorted_residuals <- sorted_residuals |>
filter(time_period == "after Patternizr")
#print(after_sorted_residuals) #120 / 2 = 60
#filter to only significant after Patternizr
significant_after_sorted_residuals <- after_sorted_residuals |> #only where standard residual is beyond the 5% significance level
filter(abs(std_residual) > 1.96)
#print(significant_after_sorted_residuals) #56
#1.96 is the z-score that is the cut off for 5% significance, there's a 5% chance that this could have happened if there was no relationship between time period and race
#sort by precinct_crime, add column to indicate over or under representation
sorted_by_precinct <- significant_after_sorted_residuals |>
arrange((precinct_crime)) |>
mutate(representation = case_when(
std_residual >= 1.96 ~ "over",
std_residual <= 1.96 ~ "under",
))
sorted_by_precinct
# ... [Your existing code above] ...
# 1. CREATE SUMMARY TABLE
race_comparison <- sorted_by_precinct |>
group_by(race, time_period, representation) |>
summarise(count = n(), .groups = "drop") |>
pivot_wider(
names_from = representation,
values_from = count,
values_fill = 0
)
print(race_comparison)
# 2. VISUALIZE THE COMPARISON (Diverging Bar Chart)
# We need to make 'under' values negative for plotting purposes
plot_data <- sorted_by_precinct |>
count(race, representation) |>
mutate(n = ifelse(representation == "under", -n, n))
library(stringr) # Make sure this is loaded
font_family <- "sans"
chisq_residuals_plot <- ggplot(plot_data, aes(x = reorder(race, n), y = n, fill = representation)) +
geom_col() +
coord_flip() +
geom_hline(yintercept = 0, color = "black") +
scale_fill_manual(values = c("under" = "#527699", "over" = "#C6983B")) +
# NEW LINE: This wraps any label longer than 15 characters
scale_x_discrete(labels = function(x) str_wrap(x, width = 15)) +
labs(
title = "Significant Deviations in Suspect Counts\nafter Patternizr",
x = "Race",
y = "Number of Precincts",
fill = "Representation"
) +
theme_minimal() +
# Optional: Make the font slightly smaller if it's still tight
#theme(axis.text.y = element_text(size = 8))  +
theme(
# Center and bold the title, making it slightly larger
plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
# Bold the axis titles
axis.title = element_text(face = "bold", size = 11),
# Bold the axis text (race names and precinct counts)
axis.text = element_text(face = "bold", size = 9, color = "black"),
# Optional: adjust the size and style of the y-axis (race) text if needed
#axis.text.y = element_text(size = 8),
# Make the legend title bold and adjust its size
legend.title = element_text(face = "bold", size = 10)
)
chisq_residuals_plot
ggsave("chi_residual_results.png", plot = chisq_residuals_plot, width = 6, height = 4, units = "in", dpi = 300)
